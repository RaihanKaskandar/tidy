{
  "name": "tidy",
  "private": true,
  "version": "1.0.0",
  "description": "A shared household cleaning schedule that divides chores fairly",
  "author": "Raihan Kaskandar (https://github.com/RaihanKaskandar)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaihanKaskandar/tidy.git"
  },
  "keywords": [
    "chores",
    "household",
    "cleaning",
    "schedule",
    "self-hosted",
    "pwa"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
